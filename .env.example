# Copy to .env for local trials. This example contains no secrets.
PORT=4173
COCO_PUBLIC_URL=http://localhost:4173
# COCO_DB_PATH=C:/coco-pets/backend/data/coco.sqlite
# Additional exact web origins, separated by commas. No wildcard.
COCO_ALLOWED_ORIGINS=
# Development writes email messages to backend/data/outbox; no email is sent.
# To deliver real emails later, configure a trusted POST webhook that accepts
# {to,subject,text}; its Bearer token must stay on the server.
COCO_MAIL_WEBHOOK_URL=
COCO_MAIL_WEBHOOK_TOKEN=
# Optional SMTP delivery for account verification and password resets.
# Leave empty to retain the private development outbox.
COCO_SMTP_HOST=
COCO_SMTP_PORT=587
COCO_SMTP_USER=
COCO_SMTP_PASSWORD=
COCO_MAIL_FROM=
